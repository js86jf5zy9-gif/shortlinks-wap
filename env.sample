# --- App (build-time, exposed to the browser bundle) ---
# Google Analytics 4 measurement ID. Leave empty to disable analytics.
# Keep the real value in .env (git-ignored) or a CI secret; never commit it.
VITE_GA_MEASUREMENT_ID=
# Optional overrides; defaults come from src/data/settings.json.
# VITE_API_URL=http://localhost:5005
# VITE_SHORT_DOMAIN=url2qr.com

# --- Deploy (used by npm run deploy / create-bucket / delete-bucket) ---
BUCKETNAME=AWS_BUCKETNAME
DIS=AWS_CLOUDFRONT_ID
AWS_PROFILE=default
REGION=us-west-1
